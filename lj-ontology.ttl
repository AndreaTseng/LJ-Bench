@prefix : <https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix lj-ontology: <https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#> .
@base <https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology> .

<https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology> rdf:type owl:Ontology ;
                                                                                  owl:versionIRI <https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology/1.0.0> .

#################################################################
#    Object Properties
#################################################################

###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#appliedTo
lj-ontology:appliedTo rdf:type owl:ObjectProperty ;
                      rdfs:domain lj-ontology:Crime ;
                      rdfs:comment "An action (e.g. a crime) applied to someone." ;
                      rdfs:label "applied to" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#attacks
lj-ontology:attacks rdf:type owl:ObjectProperty ;
                    rdfs:domain lj-ontology:Criminal ;
                    rdfs:range [ rdf:type owl:Class ;
                                 owl:unionOf ( lj-ontology:Animal
                                               lj-ontology:Company
                                               lj-ontology:Government
                                               lj-ontology:Society
                                               lj-ontology:Victim
                                             )
                               ] ;
                    rdfs:comment "hurt or defeat using violence:" ;
                    rdfs:label "attacks" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#becomes
lj-ontology:becomes rdf:type owl:ObjectProperty ;
                    rdfs:domain schema:Person ;
                    rdfs:range lj-ontology:Criminal ;
                    rdfs:comment "to start to be" ;
                    rdfs:label "becomes" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#betrays
lj-ontology:betrays rdf:type owl:ObjectProperty ;
                    rdfs:domain lj-ontology:Criminal ;
                    rdfs:range lj-ontology:Government ;
                    rdfs:comment "To not be loyal to your country or a person, often by doing something harmful such as helping their enemies." ;
                    rdfs:label "betrays" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#bribes
lj-ontology:bribes rdf:type owl:ObjectProperty ;
                   rdfs:domain lj-ontology:Criminal ;
                   rdfs:range lj-ontology:FederalOfficial ;
                   rdfs:comment "to try to make someone do something for you by giving them money, presents, or something else that they want" ;
                   rdfs:label "bribes" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#commits
lj-ontology:commits rdf:type owl:ObjectProperty ;
                    rdfs:domain lj-ontology:Criminal ;
                    rdfs:range lj-ontology:Crime ;
                    rdfs:comment "to do something illegal or something that is considered wrong" ;
                    rdfs:label "commits" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#conducts
lj-ontology:conducts rdf:type owl:ObjectProperty ;
                     rdfs:domain lj-ontology:Criminal ;
                     rdfs:range lj-ontology:Crime ;
                     rdfs:comment "to organize and perform a particular activity" ;
                     rdfs:label "conducts" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#forges
lj-ontology:forges rdf:type owl:ObjectProperty ;
                   rdfs:domain lj-ontology:Criminal ;
                   rdfs:range lj-ontology:Document ;
                   rdfs:comment "to make an illegal copy of something in order to deceive" ;
                   rdfs:label "forges" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#kidnaps
lj-ontology:kidnaps rdf:type owl:ObjectProperty ;
                    rdfs:domain lj-ontology:Criminal ;
                    rdfs:range lj-ontology:Victim ;
                    rdfs:label "kidnap" ,
                               "to take a person away illegally by force, usually in order to demand money in exchange for releasing them" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#performs
lj-ontology:performs rdf:type owl:ObjectProperty ;
                     rdfs:domain lj-ontology:Criminal ;
                     rdfs:range lj-ontology:Crime ;
                     rdfs:comment "to do an action or piece of work" ;
                     rdfs:label "performs" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#robs
lj-ontology:robs rdf:type owl:ObjectProperty ;
                 rdfs:domain lj-ontology:Criminal ;
                 rdfs:range schema:Property ;
                 rdfs:comment "to take money or property illegally from a place, organization, or person, often using violence" ;
                 rdfs:label "rob" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#steals
lj-ontology:steals rdf:type owl:ObjectProperty ;
                   rdfs:domain lj-ontology:Criminal ;
                   rdfs:range [ rdf:type owl:Class ;
                                owl:unionOf ( lj-ontology:Document
                                              schema:Property
                                            )
                              ] ;
                   rdfs:comment "to take something without the permission or knowledge of the owner and keep it" ;
                   rdfs:label "steals" .


###  https://schema.org/relatesTo
schema:relatesTo rdf:type owl:ObjectProperty ;
                 rdfs:domain schema:Question ;
                 rdfs:range lj-ontology:Crime ;
                 rdfs:comment "to be connected to, or to be about someone or something" ;
                 rdfs:label "relates to" .


#################################################################
#    Classes
#################################################################

###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Animal
lj-ontology:Animal rdf:type owl:Class ;
                   rdfs:comment "Something that lives and moves but is not a human, bird, fish, or insect." ;
                   rdfs:label "Animal" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#ArmsTrafficking
lj-ontology:ArmsTrafficking rdf:type owl:Class ;
                            rdfs:subClassOf lj-ontology:CrimeAgainstSociety ;
                            rdfs:label "Arms trafficking" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Arson
lj-ontology:Arson rdf:type owl:Class ;
                  rdfs:subClassOf lj-ontology:CrimeAgainstProperty ;
                  rdfs:comment "The criminal act of deliberately setting fire to property." ;
                  rdfs:label "Arson" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#AssaultAndBattery
lj-ontology:AssaultAndBattery rdf:type owl:Class ;
                              rdfs:subClassOf lj-ontology:CrimeAgainstPerson ;
                              rdfs:comment "Physical attack or threat of attack against another person." ;
                              rdfs:label "Assault and battery" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#BailmentCrime
lj-ontology:BailmentCrime rdf:type owl:Class ;
                          rdfs:subClassOf lj-ontology:CrimeAgainstSociety ;
                          rdfs:comment """When someone entrusted with property unlawfully converts or mis-
appropriates it for personal use, breaches the terms of the bailment
agreement, or otherwise interferes with the property in violation of the
owner’s rights.""" ;
                          rdfs:label "Crime involving bailment" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Bribery
lj-ontology:Bribery rdf:type owl:Class ;
                    rdfs:subClassOf lj-ontology:CrimeAgainstSociety ;
                    rdfs:comment "Offering, giving, receiving, or soliciting something of value to influence the actions of an official." ;
                    rdfs:label "Bribery" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Bullying
lj-ontology:Bullying rdf:type owl:Class ;
                     rdfs:subClassOf lj-ontology:CrimeAgainstPerson ;
                     rdfs:comment "Repeated aggressive behavior intended to hurt another person physically or mentally." ;
                     rdfs:label "Bullying" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Burglary
lj-ontology:Burglary rdf:type owl:Class ;
                     rdfs:subClassOf lj-ontology:CrimeAgainstProperty ;
                     rdfs:comment "The unlawful entry into a building with intent to commit a crime, especially theft." ;
                     rdfs:label "Burglary" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Captivity
lj-ontology:Captivity rdf:type owl:Class ;
                      rdfs:subClassOf lj-ontology:CrimeAgainstAnimal ;
                      rdfs:comment "Keeping animals in conditions that restrict their freedom and natural behaviors." ;
                      rdfs:label "Captivity" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#ChildAbduction
lj-ontology:ChildAbduction rdf:type owl:Class ;
                           rdfs:subClassOf lj-ontology:CrimeAgainstPerson ;
                           rdfs:comment "The illegal taking away of a child from their parent or guardian." ;
                           rdfs:label "Child abduction" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#ChildrenAbandonment
lj-ontology:ChildrenAbandonment rdf:type owl:Class ;
                                rdfs:subClassOf lj-ontology:CrimeAgainstPerson ;
                                rdfs:comment "Failing to provide necessary care, supervision, or support for a child." ;
                                rdfs:label "Children abandonment and neglect" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#ClassifiedDocument
lj-ontology:ClassifiedDocument rdf:type owl:Class ;
                               rdfs:subClassOf lj-ontology:Document ;
                               rdfs:comment "A document stated to be secret." ;
                               rdfs:label "Classified document" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Company
lj-ontology:Company rdf:type owl:Class ;
                    rdfs:subClassOf schema:Organization ;
                    rdfs:comment "An organization that sells goods or services in order to make money." ;
                    rdfs:label "Company" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Conspiracy
lj-ontology:Conspiracy rdf:type owl:Class ;
                       rdfs:subClassOf lj-ontology:CrimeAgainstSociety ;
                       rdfs:comment """An agreement between two or more people to commit a crime, accom-
panied by an overt act taken by any conspirator to further the crime.""" ;
                       rdfs:label "Conspiracy" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Counterfeiting
lj-ontology:Counterfeiting rdf:type owl:Class ;
                           rdfs:subClassOf lj-ontology:CrimeAgainstProperty ;
                           rdfs:comment "The creation of fake currency or documents with the intent to deceive." ;
                           rdfs:label "Counterfeiting" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Crime
lj-ontology:Crime rdf:type owl:Class ;
                  rdfs:comment "illegal activities" ;
                  rdfs:label "Crime" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#CrimeAgainstAnimal
lj-ontology:CrimeAgainstAnimal rdf:type owl:Class ;
                               rdfs:subClassOf lj-ontology:Crime ;
                               rdfs:comment "Illegal activity against an animal" ;
                               rdfs:label "Crime against animal" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#CrimeAgainstPerson
lj-ontology:CrimeAgainstPerson rdf:type owl:Class ;
                               rdfs:subClassOf lj-ontology:Crime ;
                               rdfs:comment "Illegal activity against a person" ;
                               rdfs:label "Crime against person" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#CrimeAgainstProperty
lj-ontology:CrimeAgainstProperty rdf:type owl:Class ;
                                 rdfs:subClassOf lj-ontology:Crime ;
                                 rdfs:comment "Illegal activity against a person" ;
                                 rdfs:label "Crime against property" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#CrimeAgainstSociety
lj-ontology:CrimeAgainstSociety rdf:type owl:Class ;
                                rdfs:subClassOf lj-ontology:Crime ;
                                rdfs:comment "Illegal activity against a society" ;
                                rdfs:label "Crime against society" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Criminal
lj-ontology:Criminal rdf:type owl:Class ;
                     rdfs:comment "Someone who commits a crime" ;
                     rdfs:label "Criminal" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#CriminalOrganization
lj-ontology:CriminalOrganization rdf:type owl:Class ;
                                 rdfs:subClassOf schema:Organization ;
                                 rdfs:comment "An organization that commits crimes." .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Cryptojacking
lj-ontology:Cryptojacking rdf:type owl:Class ;
                          rdfs:subClassOf lj-ontology:CrimeAgainstProperty ;
                          rdfs:comment "The unauthorized use of someone else's computer to mine cryptocurrency." ;
                          rdfs:label "Cryptojacking" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Cyberstalking
lj-ontology:Cyberstalking rdf:type owl:Class ;
                          rdfs:subClassOf lj-ontology:CrimeAgainstPerson ;
                          rdfs:comment "The use of the internet or other electronic means to stalk or harass an individual." ;
                          rdfs:label "Cyberstalking" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#DDoSAttack
lj-ontology:DDoSAttack rdf:type owl:Class ;
                       rdfs:subClassOf lj-ontology:CrimeAgainstProperty ;
                       rdfs:comment "Overloading a system's resources to make it unavailable to users." ;
                       rdfs:label "DDoS attack" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#DNACrime
lj-ontology:DNACrime rdf:type owl:Class ;
                     rdfs:subClassOf lj-ontology:CrimeAgainstPerson ;
                     rdfs:comment """Crimes related to the collection, storage, and use of DNA samples for
forensic purposes.""" ;
                     rdfs:label "DNA-related crime" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#DataBreach
lj-ontology:DataBreach rdf:type owl:Class ;
                       rdfs:subClassOf lj-ontology:CrimeAgainstProperty ;
                       rdfs:comment "Unauthorized access to confidential data." ;
                       rdfs:label "Data breach" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Disinformation
lj-ontology:Disinformation rdf:type owl:Class ;
                           rdfs:subClassOf lj-ontology:CrimeAgainstSociety ;
                           rdfs:comment "The deliberate spread of false information." ;
                           rdfs:label "Disinformation" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Document
lj-ontology:Document rdf:type owl:Class ;
                     rdfs:comment "A paper or set of papers with written or printed information, especially of an official type. It can also be a digital document." ;
                     rdfs:label "Document" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#DrugAlcohol
lj-ontology:DrugAlcohol rdf:type owl:Class ;
                        rdfs:subClassOf lj-ontology:CrimeAgainstSociety ;
                        rdfs:comment "Crimes involving the illegal use, possession, distribution, or production of drugs and alcohol." ;
                        rdfs:label "Drug and alcohol" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#DrugTrafficking
lj-ontology:DrugTrafficking rdf:type owl:Class ;
                            rdfs:subClassOf lj-ontology:CrimeAgainstSociety ;
                            rdfs:label "Drug trafficking" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Embezzlement
lj-ontology:Embezzlement rdf:type owl:Class ;
                         rdfs:subClassOf lj-ontology:CrimeAgainstProperty ;
                         rdfs:comment """The unlawful act of wrongfully taking or misappropriating funds or
property that have been entrusted to someone for their care or manage-
ment.""" ;
                         rdfs:label "Embezzlement" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#EnvironmentalCrime
lj-ontology:EnvironmentalCrime rdf:type owl:Class ;
                               rdfs:subClassOf lj-ontology:CrimeAgainstSociety ;
                               rdfs:comment "Violations of laws designed to protect the environment." ;
                               rdfs:label "Environmental crime" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Escape
lj-ontology:Escape rdf:type owl:Class ;
                   rdfs:subClassOf lj-ontology:CrimeAgainstSociety ;
                   rdfs:comment "The act of breaking free from confinement or custody and assisting others in doing so." ;
                   rdfs:label "Escapes and aiding therein" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Espionage
lj-ontology:Espionage rdf:type owl:Class ;
                      rdfs:subClassOf lj-ontology:CrimeAgainstSociety ;
                      rdfs:comment "The practice of spying or using spies to obtain information." ;
                      rdfs:label "Espionage" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Exploitation
lj-ontology:Exploitation rdf:type owl:Class ;
                         rdfs:subClassOf lj-ontology:CrimeAgainstAnimal ;
                         rdfs:comment "The unethical use of animals for personal gain." ;
                         rdfs:label "Exploitation" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Extortion
lj-ontology:Extortion rdf:type owl:Class ;
                      rdfs:subClassOf lj-ontology:CrimeAgainstProperty ;
                      rdfs:comment """Obtaining money, property, or services from another person through
coercion, threats, or intimidation.""" ;
                      rdfs:label "Extortion" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#FalseImprisonment
lj-ontology:FalseImprisonment rdf:type owl:Class ;
                              rdfs:subClassOf lj-ontology:CrimeAgainstPerson ;
                              rdfs:comment "he unlawful restraint of a person against their will; the illegal trade of humans for exploitation or commercial gain." ;
                              rdfs:label "False Imprisonment" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#FalsifyingEvidence
lj-ontology:FalsifyingEvidence rdf:type owl:Class ;
                               rdfs:subClassOf lj-ontology:CrimeAgainstPerson ;
                               rdfs:comment "Falsifying evidence" ;
                               rdfs:label "Falsifying evidence" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#FederalOfficial
lj-ontology:FederalOfficial rdf:type owl:Class ;
                            rdfs:subClassOf schema:Person ;
                            rdfs:comment "Any agent or representative of a federal agency or bureau" ;
                            rdfs:label "Federal official" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#FederalProperty
lj-ontology:FederalProperty rdf:type owl:Class ;
                            rdfs:subClassOf schema:Property ;
                            rdfs:comment "Property relating to the central government." ;
                            rdfs:label "Federal Property" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#FederalPropertyCrime
lj-ontology:FederalPropertyCrime rdf:type owl:Class ;
                                 rdfs:subClassOf lj-ontology:CrimeAgainstProperty ;
                                 rdfs:comment "Offenses committed on land owned or controlled by the federal government." ;
                                 rdfs:label "Crime on federal property" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#FederalTaxEvasion
lj-ontology:FederalTaxEvasion rdf:type owl:Class ;
                              rdfs:subClassOf lj-ontology:CrimeAgainstSociety ;
                              rdfs:comment "The illegal non-payment or underpayment of tax." ;
                              rdfs:label "Federal tax evasion" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Fraud
lj-ontology:Fraud rdf:type owl:Class ;
                  rdfs:subClassOf lj-ontology:CrimeAgainstProperty ;
                  rdfs:comment "Wrongful or criminal deception intended to result in financial or personal gain." ;
                  rdfs:label "Fraud" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Gambling
lj-ontology:Gambling rdf:type owl:Class ;
                     rdfs:subClassOf lj-ontology:CrimeAgainstSociety ;
                     rdfs:comment "Wagering money or something of value on an event with an uncertain outcome." ;
                     rdfs:label "Gambling" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Government
lj-ontology:Government rdf:type owl:Class ;
                       rdfs:subClassOf schema:Organization ;
                       rdfs:comment "The group of people who officially control a country" ;
                       rdfs:label "Government" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Hacking
lj-ontology:Hacking rdf:type owl:Class ;
                    rdfs:subClassOf lj-ontology:CrimeAgainstProperty ;
                    rdfs:comment "Unauthorized access to data in a system or computer." ;
                    rdfs:label "Hacking" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#HarmfulMatter
lj-ontology:HarmfulMatter rdf:type owl:Class ;
                          rdfs:subClassOf lj-ontology:CrimeAgainstSociety ;
                          rdfs:comment "The distribution or exhibition of materials considered harmful or obscene." ;
                          rdfs:label "Harmful matter" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#HateCrime
lj-ontology:HateCrime rdf:type owl:Class ;
                      rdfs:subClassOf lj-ontology:CrimeAgainstPerson ;
                      rdfs:comment "Crimes motivated by prejudice or hatred towards a particular group." ;
                      rdfs:label "Hate crime" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#HoldingHostage
lj-ontology:HoldingHostage rdf:type owl:Class ;
                           rdfs:subClassOf lj-ontology:CrimeAgainstPerson ;
                           rdfs:comment "Taking or holding a person as security for the fulfillment of certain conditions." ;
                           rdfs:label "Holding hostage" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#Homicide
lj-ontology:Homicide rdf:type owl:Class ;
                     rdfs:subClassOf lj-ontology:CrimeAgainstPerson ;
                     rdfs:comment "The deliberate and unlawful killing of one person by another." ;
                     rdfs:label "Homicide" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#HorseRacing
lj-ontology:HorseRacing rdf:type owl:Class ;
                        rdfs:subClassOf lj-ontology:CrimeAgainstSociety ;
                        rdfs:comment "Betting on the outcome of horse races, often illegally." ;
                        rdfs:label "Horse racing" .


###  https://anonymous.4open.science/r/LJ-bench_ontology_crime_LLM-BC96/lj-ontology#HumanTrafficking
lj-ontology:HumanTrafficking rdf:type owl:Class ;
                             rdfs:subClassOf lj-ontology:CrimeAgainstPerson ;
                             rdfs:comment "The unlawful restraint of a person against their will; the illegal trade of humans for exploitation or commercial gain." ;
